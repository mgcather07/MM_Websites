# Copy to .env.local for local development. Never commit real secrets.

# --- Firebase Admin (server-side Firestore writes) ---
# In production on App Hosting these are provided automatically.
# For local dev, either point at a service-account JSON file:
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
# ...or paste the JSON inline (single line):
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
FIREBASE_PROJECT_ID=mm-websites

# --- Email notifications (Resend) ---
# Create a key at https://resend.com. Without it, leads still save to Firestore.
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@mmwebsites.com
# Must be a verified Resend sender. onboarding@resend.dev works for testing.
LEAD_FROM_EMAIL=M&M Websites <onboarding@resend.dev>
