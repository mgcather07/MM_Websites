{
  "rules": {
    ".read": false,
    ".write": false,

    // Any signed-in account can read the admin list (only you two have accounts —
    // no public signup). Used for the bootstrap check and self/role lookups.
    "admins": {
      ".read": "auth != null",
      "$uid": {
        // Bootstrap: the first sign-in with no admins yet may create its own
        // record (becomes master). After that, only a master can add/edit admins.
        ".write": "auth != null && ((!root.child('admins').exists() && $uid === auth.uid) || root.child('admins').child(auth.uid).child('role').val() === 'master')"
      }
    },

    // Client / CRM data — readable and writable only by a signed-in admin.
    "clients": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "projects": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "payments": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    // Quote-form inbox. A public visitor (unauthenticated) may CREATE a new
    // lead but cannot read, edit, or delete. Admins have full access. Field
    // validation + no-unknown-keys keeps junk out; App Check locks it further.
    "leads": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "(!data.exists() && auth == null) || (auth != null && root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['name','need','createdAt']) && ((newData.child('phone').isString() && newData.child('phone').val().length > 0) || (newData.child('email').isString() && newData.child('email').val().length > 0))",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "business": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "need": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "currentUrl": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "features": {
          ".validate": true,
          "$i": { ".validate": "newData.isString() && newData.val().length <= 60" }
        },
        "timeline": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "budget": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "assets": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "details": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "source": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "clientId": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "handledAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // Quotes. Admins read the whole list and write; a specific quote is
    // publicly readable by its (unguessable) id, so a client can open the
    // shareable link without signing in. Only admins can create/edit.
    "quotes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "ndas": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "signature": {
          ".write": "(!data.exists() && auth == null) || (auth != null && root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['name','agreedAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "agree": { ".validate": "newData.isBoolean()" },
          "agreedAt": { ".validate": "newData.isNumber()" },
          "userAgent": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "$other": { ".validate": false }
        }
      }
    },

    // Counters (e.g. next client number), admin-only.
    "_meta": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
